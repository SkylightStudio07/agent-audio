{
  "default": "stable-audio-3-medium",
  "models": {
    "stable-audio-3-medium": {
      "provider": "stability-ai",
      "upstream_id": "medium",
      "capabilities": [
        "text-to-audio",
        "music",
        "sound-effects",
        "ambience",
        "audio-to-audio",
        "inpainting",
        "continuation"
      ],
      "max_seconds": 380,
      "backends": {
        "mlx": {
          "status": "supported",
          "platform": "macOS Apple Silicon",
          "source": "official optimized/mlx runtime"
        },
        "tflite": {
          "status": "supported",
          "platform": "Windows/macOS/Linux x86 and ARM CPU",
          "source": "official optimized/tflite runtime"
        },
        "cuda": {
          "status": "opt-in-validated-windows-rtx5060ti",
          "platform": "NVIDIA, Windows/Linux x86-64",
          "note": "A 3-second Medium WAV through standalone stdio MCP was verified on Windows with an RTX 5060 Ti. Other GPUs and Linux CUDA remain unverified."
        },
        "rocm": {
          "status": "opt-in-generation-unverified",
          "platform": "AMD, ROCm 6.3 supported Linux x86-64 systems",
          "note": "Official PyTorch runtime with ROCm 6.3 wheels and installation GPU kernel probe. Windows AMD uses CPU. Real generation remains unverified."
        },
        "xpu": {
          "status": "experimental-not-enabled",
          "platform": "Intel GPU",
          "note": "No acceleration claim is made in v0.1. Intel systems remain supported via the CPU fallback."
        }
      }
    }
  }
}
